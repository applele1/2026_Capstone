generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}

// ===== 식당 데이터: 엑셀(restaurants / menus / categories / menu_categories)과 같은 구조 =====
model Restaurant {
 id Int @id @default(autoincrement())
 name String
 address String
 lat Float
 lng Float
 menus Menu[]
 reviews Review[]
 favorites Favorite[]
 recentViews RecentView[]
 interactions UserMenuInteraction[]
 @@map("restaurants")
}
model Menu {
 id Int @id @default(autoincrement())
 restaurantId Int @map("restaurant_id")
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 name String
 price Int
 // ===== 심층 추천용 메뉴 속성 =====
 spicyLevel Int @default(0) @map("spicy_level") @db.SmallInt     // 0 안 매움 · 1 살짝 · 2 매콤 · 3 아주 매움
 portionLevel Int @default(2) @map("portion_level") @db.SmallInt // 1 가볍게 · 2 보통 · 3 든든하게
 isRice Boolean @default(false) @map("is_rice")
 isNoodle Boolean @default(false) @map("is_noodle")
 isSoup Boolean @default(false) @map("is_soup")
 isMeat Boolean @default(false) @map("is_meat")
 categories MenuCategory[]
 tags MenuTag[]
 interactions UserMenuInteraction[]
 @@index([restaurantId,price])
 @@map("menus")
}
// 메뉴의 느낌 태그 (뜨끈한·시원한·바삭한·치즈·해산물·건강한·간편한)
model Tag {
 id Int @id @default(autoincrement())
 name String @unique
 menus MenuTag[]
 @@map("tags")
}
model MenuTag {
 menuId Int @map("menu_id")
 tagId Int @map("tag_id")
 menu Menu @relation(fields:[menuId],references:[id],onDelete:Cascade)
 tag Tag @relation(fields:[tagId],references:[id],onDelete:Cascade)
 @@id([menuId,tagId])
 @@index([tagId])
 @@map("menu_tags")
}
model Category {
 id Int @id @default(autoincrement())
 name String @unique
 menus MenuCategory[]
 @@map("categories")
}
// 메뉴 하나가 여러 카테고리에 속할 수 있습니다. (예: 돈까스덮밥 → 덮밥 + 일식)
model MenuCategory {
 menuId Int @map("menu_id")
 categoryId Int @map("category_id")
 menu Menu @relation(fields:[menuId],references:[id],onDelete:Cascade)
 category Category @relation(fields:[categoryId],references:[id],onDelete:Cascade)
 @@id([menuId,categoryId])
 @@map("menu_categories")
}

// ===== 회원 데이터 =====
model User {
 id Int @id @default(autoincrement())
 email String @unique
 password String
 name String
 role String @default("user")   // user · admin
 createdAt DateTime @default(now()) @map("created_at")
 reviews Review[]
 favorites Favorite[]
 recentViews RecentView[]
 sessions Session[]
 interactions UserMenuInteraction[]
}
model Review {
 id Int @id @default(autoincrement())
 userId Int @map("user_id")
 restaurantId Int @map("restaurant_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 rating Int
 comment String @db.VarChar(300)
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime? @map("updated_at")
 @@unique([userId,restaurantId])
}
model Favorite {
 id Int @id @default(autoincrement())
 userId Int @map("user_id")
 restaurantId Int @map("restaurant_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([userId,restaurantId])
}
model RecentView {
 id Int @id @default(autoincrement())
 userId Int @map("user_id")
 restaurantId Int @map("restaurant_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 viewedAt DateTime @default(now()) @map("viewed_at")
 @@unique([userId,restaurantId])
}
model Session {
 id Int @id @default(autoincrement())
 tokenHash String @unique @map("token_hash")
 userId Int @map("user_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime @map("expires_at")
 @@index([expiresAt])
}

// ===== 행동 기록: 개인화(심층) 추천에 사용 =====
// type: view(식당 상세 열기) · click(추천 목록에서 메뉴 선택) · recommend_click(심층 추천 결과 선택)
// 찜·후기는 Favorite·Review 테이블을 그대로 사용하므로 여기에 중복 저장하지 않습니다.
model UserMenuInteraction {
 id Int @id @default(autoincrement())
 userId Int @map("user_id")
 restaurantId Int @map("restaurant_id")
 menuId Int? @map("menu_id")
 type String
 createdAt DateTime @default(now()) @map("created_at")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 menu Menu? @relation(fields:[menuId],references:[id],onDelete:Cascade)
 @@index([userId,createdAt])
 @@index([menuId])
 @@map("user_menu_interactions")
}

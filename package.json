{
  "name": "bapit-mvc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:seed:test-users": "prisma db execute --schema prisma/schema.prisma --file supabase/03_seed_test_users.sql",
    "seed:generate": "node scripts/generate-seed.js",
    "format": "prettier --write \"src/**/*.js\" \"public/js/*.js\" \"public/css/*.css\" \"tests/*.js\" \"scripts/*.js\" prisma/seed.js",
    "format:check": "prettier --check \"src/**/*.js\" \"public/js/*.js\" \"public/css/*.css\" \"tests/*.js\" \"scripts/*.js\" prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "16.6.1",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prisma": "6.19.0"
  },
  "allowScripts": {
    "prisma@6.19.0": true,
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}

PORT=3000
NODE_ENV=development
# demo: 로컬 JSON 저장 / postgres: Supabase PostgreSQL + Prisma
STORAGE_MODE=demo
DEMO_DATA_PATH=./data/demo.json
# demo 모드 첫 실행 때 테스트 계정(admin@bapit.test / user01~50@bapit.test)을 넣습니다. 끄려면 false
DEMO_TEST_USERS=true
DATABASE_URL=""
DIRECT_URL=""
# ===== 카카오맵 키 입력 위치 (이 파일이 아니라 복사한 .env에 입력하세요. .env.example은 Git에 올라갑니다) =====
# JavaScript 키: 브라우저 지도에 사용. 웹 도메인 등록 필요
KAKAO_MAP_JS_KEY=
# REST API 키: 서버 전용. 프론트엔드에 노출하지 마세요.
KAKAO_REST_API_KEY=
# 경인여대 중심 좌표: 실제 서비스 전 정문 기준으로 확인/보정
SCHOOL_LAT=37.5505
SCHOOL_LNG=126.7223
